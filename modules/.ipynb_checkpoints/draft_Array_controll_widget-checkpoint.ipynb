    "# тестовый запуск\n",
    "import tkinter as tk\n",
    "from tkinter import ttk\n",
    "\n",
    "class MainApplication(tk.Tk):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.title(\"Main Application with Custom Widgets\")\n",
    "\n",
    "        self.widget1 = Array_controll(self\n",
    "                                      # , on_click_callback=self.handle_widget_event\n",
    "        )\n",
    "        self.widget1.pack(padx=2, pady=2)\n",
    "\n",
    "    def handle_widget_event(self):\n",
    "        print(self.widget1.take_text())\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    app = MainApplication()\n",
    "    app.mainloop()"
