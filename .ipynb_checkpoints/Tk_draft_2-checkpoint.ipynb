    "# Интерфейс панельки GUI\n",
    "\n",
    "import tkinter as tk\n",
    "from tkinter import ttk\n",
    "\n",
    "class App:\n",
    "    def __init__(self, root, **kwargs):\n",
    "        self.controller = PrinterController(**kwargs)\n",
    "        # self.controller = CoppeliaController(**kwargs)\n",
    "        \n",
    "        self.root = root\n",
    "        self.root.title(\"Управление принтером\")\n",
    "        self.root.geometry(\"400x300\")  # Размер окна\n",
    "\n",
    "        # Привязываем события клавиатуры к обработчикам\n",
    "        self.root.bind(\"<Key>\", self.on_key_press)\n",
    "        self.root.bind(\"<KeyRelease>\", self.on_key_release)\n",
    "        \n",
    "        self._flags = {\n",
    "            'connect': False,\n",
    "            'listen_keys': False,\n",
    "            'abs_rel': True,\n",
    "            'test': False\n",
    "        }\n",
    "        self._widgets = {}\n",
    "        self.key_states = {}\n",
    "\n",
    "        # Создание виджетов\n",
    "        self.create_widgets()\n",
    "\n",
    "\n",
    "    # def on_connect_bt(self):\n",
    "    #     print(\"connect\")\n",
    "    #     self.controller.connect()\n",
    "\n",
    "    # def on_disconnect_bt(self):\n",
    "    #     print(\"disconnect\")\n",
    "    #     self.controller.disconnect()\n",
    "\n",
    "    def on_key_press(self, event):\n",
    "        \"\"\"\n",
    "        Обработчик события нажатия клавиши.\n",
    "        :param event: Объект события, содержащий информацию о нажатой клавише.\n",
    "        \"\"\"\n",
    "        if not self._flags['listen_keys']:\n",
    "            return\n",
    "        \n",
    "        key = event.keysym  # Символ клавиши (например, \"a\", \"Shift\", \"Return\")\n",
    "        if self.key_states.get(key, False):        # Если клавиша уже нажата, игнорируем автоповтор\n",
    "            return\n",
    "        self.key_states[key] = True        # Помечаем клавишу как нажатую\n",
    "        char = event.char   # Символ, если клавиша генерирует текст (например, \"a\", \"1\")\n",
    "        \n",
    "        _move = {'x':0, 'y':0, 'z':0, 'e':0}\n",
    "        if char in ('w', 'W', 'ц', 'Ц'):\n",
    "            _move['y'] += 5\n",
    "        if char in ('s', 'S', 'ы', 'Ы'):\n",
    "            _move['y'] -= 5\n",
    "        if char in ('d', 'D', 'в', 'В'):\n",
    "            _move['x'] += 5\n",
    "        if char in ('a', 'A', 'ф', 'Ф'):\n",
    "            _move['x'] -= 5\n",
    "\n",
    "        if key == 'Up':\n",
    "            _move['z'] += 5\n",
    "        if key == 'Down':\n",
    "            _move['z'] -= 5\n",
    "        if key == 'Left':\n",
    "            _move['e'] += 1\n",
    "        if key == 'Right':\n",
    "            _move['e'] -= 1\n",
    "        \n",
    "        self.controller.move_realtive(**_move)\n",
    "\n",
    "    def on_key_release(self, event):\n",
    "        \"\"\"\n",
    "        Обработчик события отпускания клавиши.\n",
    "        \"\"\"\n",
    "        key = event.keysym       # Символ клавиши (например, \"a\", \"Shift\", \"Return\")\n",
    "        self.key_states[key] = False            # Помечаем клавишу как отпущенную\n",
    "    \n",
    "    def connect_disconnect(self):\n",
    "        self._flags['connect'] = not self._flags['connect']\n",
    "        if self._flags['connect']:\n",
    "            print(\"connect\")\n",
    "            self.controller.connect()\n",
    "        else:\n",
    "            print(\"dissconnect\")\n",
    "            self.controller.disconnect()\n",
    "    \n",
    "    def on_home_bt(self):\n",
    "        print(\"home\")\n",
    "        self.controller.home()\n",
    "\n",
    "    def on_setZero_bt(self):\n",
    "        print(\"setZero\")\n",
    "        self.controller.set_zero()\n",
    "\n",
    "    def on_absalute_bt(self):\n",
    "        print(\"absalute\")\n",
    "        self.controller._set_abs_cords()\n",
    "\n",
    "    def on_relative_bt(self):\n",
    "        print(\"relative\")\n",
    "        self.controller._set_rel_cords()\n",
    "\n",
    "    def on_get_pos_bt(self):\n",
    "        print(\"get_pos\")\n",
    "        print(self.controller.get_position())\n",
    "        print(self.controller.position)\n",
    "\n",
    "    def on_keyboard_bt(self):\n",
    "        self._flags['listen_keys'] = not self._flags['listen_keys']\n",
    "        self.root.focus_set()\n",
    "        \n",
    "        if self._flags['listen_keys']:\n",
    "            self._widgets[\"text_area\"].config(state=\"disabled\")  # Отключаем\n",
    "        else:\n",
    "            self._widgets[\"text_area\"].config(state=\"normal\")\n",
    "\n",
    "    def on_abs_rel(self):\n",
    "        self._flags['abs_rel'] = not self._flags['abs_rel']\n",
    "        if self._flags['abs_rel']:\n",
    "            self._widgets['abs_rel_bt'].config(text='in abs')\n",
    "            self.controller._set_abs_cords()\n",
    "        else:\n",
    "            self._widgets['abs_rel_bt'].config(text='in rel')\n",
    "            self.controller._set_rel_cords()\n",
    "\n",
    "    def on_test_bt(self):\n",
    "        self.controller.move_realtive(e=360)\n",
    "    \n",
    "    def on_Xplus_bt(self):\n",
    "        self.controller.move_realtive(x=5)\n",
    "\n",
    "    def on_Xminus_bt(self):\n",
    "        self.controller.move_realtive(x=-5)\n",
    "\n",
    "    def on_Yplus_bt(self):\n",
    "        self.controller.move_realtive(y=5)\n",
