    "        self._widgets['rf_panel']._keyboard_dissable(self._flags['listen_keys'])\n",
    "        self._widgets['uf_panel']._keyboard_dissable(self._flags['listen_keys'])\n",
    "\n",
    "    # =========================================================================================\n",
    "    def create_widgets(self):\n",
    "        self._add_buttons_panel()\n",
    "        self._add_arroy_panel()\n",
    "        self._add_input_area()\n",
    "        self.root.columnconfigure(1, weight=1) # Столбец 0 растягивается\n",
    "        self.root.rowconfigure(1, weight=1)    # Строка 0 растягивается\n",
    "        self._add_cords_panel()\n",
    "        \n",
    "    # =========================================================================================\n",
    "    def _add_input_area(self):\n",
    "        # frame = tk.Frame(self.root, borderwidth=2, relief=\"groove\")\n",
    "        frame = GcodeArea(self.root, on_click_callback=self.print_text)\n",
    "        frame.grid(row=1, column=1, rowspan=1, padx=2, pady=2, sticky=\"ew\")\n",
    "        self._widgets[\"text_area\"] = frame\n",
    "\n",
    "    def print_text(self):\n",
    "        \"\"\"Выводит содержимое текстового поля в консоль.\"\"\"\n",
    "        # Получаем текст из текстового поля\n",
    "        text_content = self._widgets[\"text_area\"].take_text()\n",
    "        self.controller.send_command(text_content)\n",
    "    # -----------------------------------------------------------------------------------------\n",
    "    def _add_arroy_panel(self):\n",
    "        self._widgets[\"array_area\"] = Array_controll(\n",
    "                        self.root, on_click_callback=self.on_arroys, \n",
    "                        k_e=self.controller.k_e)\n",
    "\n",
    "        self._widgets[\"array_area\"].grid(row=0, column=1, rowspan=1, padx=2, pady=2, sticky=\"ew\")\n",
    "\n",
    "    def on_arroys(self, **out):\n",
    "        self.controller.move_realtive(**out)\n",
    "  \n",
    "    # =========================================================================================\n",
    "    def _add_buttons_panel(self):\n",
    "        frame_1 = tk.Frame(self.root, borderwidth=2, relief=\"groove\")\n",
    "        frame_1.grid(row=0, column=0, rowspan=2, padx=2, pady=2, sticky=\"nwe\")\n",
    "\n",
    "        connect_bt = tk.Checkbutton(frame_1, text=\"CONNECT\", \n",
    "                            command=self.connect_disconnect, indicatoron=False)\n",
    "        connect_bt.pack(side=\"top\", fill=\"x\", expand=True, anchor=\"n\")\n",
    "        self._widgets['connect_bt'] = connect_bt\n",
    "\n",
    "        home_bt = tk.Button(frame_1, text=\"HOME\", command=self.on_home_bt)\n",
