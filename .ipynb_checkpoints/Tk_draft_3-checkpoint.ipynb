   "source": [
    "# ПУСКАТЕЛЬ ДЛЯ НАСТОЯЩЕГО ПРИНТЕРА\n",
    "k_e = 31.45/360\n",
    "# k_e=(np.pi*(9.7+1.75/4))/360\n",
    "\n",
    "try:\n",
    "    root = tk.Tk()\n",
    "    app = App(root, \n",
    "              com_port='COM4', baud_rate=115200, timeout=0.2, \n",
    "              debug=True, k_e=k_e,  speed=1000)\n",
    "    root.mainloop()\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"Ошибка: {e}\")\n",
    "    root.destroy()\n",
    "\n",
    "finally:\n",
    "    # Закрытие соединения\n",
    "    if 'app' in locals() and not app.controller.connection is None and app.controller.connection.is_open:\n",
    "        app.controller.disconnect()"
   ]
