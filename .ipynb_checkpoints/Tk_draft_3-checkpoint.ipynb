    "class FrameXYZE:\n",
    "    \"\"\" Принимает координаты в пространстве 1, возвращает в пространстве 2,\n",
    "    хранит матрицу перехода и процедуры создания такой матрицы \"\"\"\n",
    "    def __init__(self, **kwargs):\n",
    "        self.from_R_to_U_rotate = None\n",
    "        self.from_U_to_R_rotate = None\n",
    "        self.from_R_to_U_translate = None\n",
    "        self.from_U_to_R_translate = None\n",
    "\n",
    "        self.k_e = kwargs.get(k_e, 31.45/360)\n",
    "\n",
    "        self.get_rotation(kwargs.get('rot_M', [[1,0,0],[0,1,0],[0,0,1]]))\n",
    "        self.get_translate(kwargs.get('tr_V', [0,0,0]))\n",
    "\n",
    "    def invert_matrix(self, matrix):\n",
    "        try:\n",
    "            inverse_matrix = np.linalg.inv(matrix)\n",
    "        except np.linalg.LinAlgError:\n",
    "            inverse_matrix = np.linalg.pinv(matrix)\n",
    "        \n",
    "        return inverse_matrix\n",
    "    \n",
    "    def _convert_from_R_to_U(self, cords_U):\n",
    "        if not type(cords_U) is np.ndarray:\n",
    "            cords_U = np.array(cords_U) \n",
    "        cords_R = self.from_R_to_U_rotate @ cords_U + self.from_R_to_U_translate\n",
    "        return cords_R\n",
    "\n",
    "    def _convert_from_U_to_R(self, cords_R):\n",
    "        if not type(cords_R) is np.ndarray:\n",
    "            cords_R = np.array(cords_R)\n",
    "        cords_U = self.from_U_to_R_rotate @ cords_R + self.from_U_to_R_translate\n",
    "        return cords_U\n",
    "\n",
    "    def convert_xyze_UtoR(self, cords_U):\n",
    "        if not type(cords_U) is np.ndarray:\n",
    "            cords_U = np.array(cords_U)\n",
    "\n",
    "        e = np.round(cords_U[3] * self.k_e, 5) \n",
    "        pos = self._convert_from_U_to_R(cords_U[:3])\n",
    "        return np.append(pos, e)\n",
    "\n",
    "    def convert_xyze_RtoU(self, cords_R):\n",
    "        if not type(cords_R) is np.ndarray:\n",
    "            cords_R = np.array(cords_R)\n",
    "\n",
    "        e = np.round(cords_R[3] / self.k_e, 5)\n",
    "        pos = self._convert_from_R_to_U(cords_R[:3])\n",
    "        return np.append(pos, e)\n",
    "\n",
    "    def get_rotation(self, rot_matrix):\n",
    "        \"\"\" Прием готовой матрицы поворота \"\"\"\n",
    "        if not type(rot_matrix) is np.ndarray:\n",
    "            rot_matrix = np.array(rot_matrix)\n",
    "        self.from_R_to_U_rotate = rot_matrix\n",
    "        self.from_U_to_R_rotate = self.invert_matrix(self.from_R_to_U_rotate)\n",
    "    \n",
    "    def get_translate(self, translate_vector):\n",
    "        \"\"\" Прием готового вектора смещения \"\"\"\n",
    "        if type(translate_vector) is np.ndarray:\n",
    "            translate_vector = np.array(translate_vector)\n",
    "        self.from_R_to_U_translate = translate_vector\n",
    "        self.from_U_to_R_translate = -self.from_R_to_U_rotate @ self.from_R_to_U_translate\n",
    "    \n",
    "    def x3dots_to_rotation(self, dot0, dotX, dotY, dotZ=None):\n",
    "        \"\"\" формирует матрицу поворота по трем точкам \"\"\"\n",
    "        return np.array([[1,0,0],[0,1,0],[0,0,1]])\n",
    "\n",
    "# A = FrameXYZE()\n",
    "# print( A._convert_from_R_to_U([2, 6, 8]) )\n",
    "# print( A._convert_from_R_to_U(np.array([2, 6, 8])) )\n",
    "# print( A._convert_from_U_to_R(np.array([12, 14, 42])) )\n",
    "\n",
    "# print( A.convert_xyze_UtoR([12, 14, 24, 10]) )\n",
    "# print( A.convert_xyze_RtoU([2, 6, 26, 0.87]) )"
   ]
