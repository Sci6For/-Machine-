    "                       'test': False}\n",
    "        self._widgets = {}\n",
    "\n",
    "        self.frames = [FrameXYZE(k_e=self.controller.k_e),]\n",
    "        self.work_frame = 0\n",
    "\n",
    "        # Создание виджетов\n",
    "        self.create_widgets()\n",
    "\n",
