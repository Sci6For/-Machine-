    "def make_a_turn(b, L, h, a):\n",
    "    \"\"\" Формирует последовательность точек образующих виток \"\"\"\n",
    "    dots = np.array([\n",
    "        [+b/2, 0, h, a],        [+b/2, L, h, a],\n",
    "        [-b/2, L, h, a],        [-b/2, 0, h, a],\n",
    "        [0, 0, h, a]\n",
    "    ])\n",
    "    return dots\n",
    "\n",
    "def add_offset(dots, offset):\n",
    "    \"\"\" Добавляет в массив точек оффсет \"\"\"\n",
    "    if not type(offset) is np.ndarray:\n",
    "        offset = np.array(offset)\n",
    "    dots += offset\n",
    "    return dots\n",
    "\n",
    "def from_U_frame(dots, frame):\n",
    "    \"\"\" Проецирует массив координат в нужный фрейм \"\"\"\n",
    "    for i in range(dots.shape[0]):\n",
    "        # print(frame.convert_xyze_UtoR(dots[i, :]))\n",
    "        dots[i, :] = frame.convert_xyze_UtoR(dots[i, :])\n",
    "    return dots\n",
    "\n",
    "def to_Gcode(dots, G):\n",
    "    \"\"\" Преобразует массив координат в G-code \"\"\"\n",
    "    rez_strings = []\n",
    "    for i in range(dots.shape[0]):\n",
    "        rez_strings.append(f'{G} X{dots[i,0]} Y{dots[i,1]} Z{dots[i,2]} E{dots[i,3]}')\n",
    "    return rez_strings\n",
    "\n",
    "# def from_Gcode():\n",
    "#     \"\"\" Парсит строку G-code извлекая массив координат \"\"\"\n",
    "#     pass\n",
    "\n",
    "# def Gcode_to_frame():\n",
    "#     \"\"\" Проецирует многострочный G-code в нужный фрейм \"\"\"\n",
    "#     pass\n",
    "\n",
    "F = FrameXYZE(rot_M=[[0.7, 0.2, 0], [-0.2, 0.7, 0], [0, 0, 0]])\n",
    "D = make_a_turn(4, 10, 5, 6)\n",
    "# print(D)\n",
    "# print(add_offset(D, [.10, .20, .30, 0]))\n",
    "# print(from_U_frame(D, F))\n",
    "to_Gcode(D, 'G1')"
   ]
