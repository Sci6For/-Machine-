   "source": [
    "import serial\n",
    "import time\n",
    "\n",
    "# Настройка COM-порта\n",
    "com_port = 'COM4'  # Замените на ваш COM-порт (например, COM3, /dev/ttyUSB0)\n",
    "baud_rate = 115200   # Скорость передачи данных (обычно 9600, 115200)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "efc300e6-b91c-4dd0-91e9-c056157b5bc7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Подключено к COM4 со скоростью 115200 бод\n",
      "Отправлено сообщение: G1 Z35.0 F6000 ;move the platform down 15mm\n",
      "\n",
      "Получен ответ: ok\n",
      "\n",
      "Соединение закрыто\n"
     ]
    }
   ],
   "source": [
    "messages = [\n",
    "    \"G21        ;metric values\",                     # 0\n",
    "    \"G90        ;absolute positioning\",              # 1\n",
    "    \"M82        ;set extruder to absolute mode\",     # 2\n",
    "    \"M107       ;start with the fan off\",            # 3\n",
    "    \"G28 X0 Y0  ;move X/Y to min endstops\",          # 4\n",
    "    \"G28 Z0     ;move Z to min endstops\",            # 5\n",
    "    \"G1 Z15.0 F6000 ;move the platform down 15mm\",   # 6\n",
    "    \"G92 E0     ;zero the extruded length\",          # 7\n",
    "    \"G1 F200 E3 ;extrude 3mm of feed stock\",         # 8\n",
    "    \"G92 E0     ;zero the extruded length again\",    # 9\n",
    "    \"G1 F6000\",                                      # 10\n",
    "    \"G1 Z35.0 F6000 ;move the platform down 15mm\",   # 11\n",
    "    \"G0 Z5.0 \"\n",
    "          ]\n",
    "\n",
    "ms = 11\n",
    "\n",
    "try:\n",
    "    # Открытие соединения с COM-портом\n",
    "    ser = serial.Serial(com_port, baud_rate, timeout=1)\n",
    "    print(f\"Подключено к {com_port} со скоростью {baud_rate} бод\")\n",
    "\n",
    "    # Текстовое сообщение для отправки\n",
    "    message = messages[ms] + \"\\n\"  # Добавляем '\\n' для завершения строки\n",
    "\n",
    "    # Отправка сообщения\n",
    "    ser.write(message.encode('utf-8'))  # Кодируем строку в байты\n",
    "    print(f\"Отправлено сообщение: {message}\")\n",
    "\n",
    "    # Ожидание ответа (если устройство отвечает)\n",
    "    time.sleep(1)  # Ждём немного, чтобы устройство успело обработать запрос\n",
    "    if ser.in_waiting > 0:\n",
    "        response = ser.read(ser.in_waiting).decode('utf-8')  # Читаем ответ\n",
    "        print(f\"Получен ответ: {response}\")\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"Ошибка: {e}\")\n",
    "\n",
    "finally:\n",
    "    # Закрытие соединения\n",
    "    if 'ser' in locals() and ser.is_open:\n",
    "        ser.close()\n",
    "        print(\"Соединение закрыто\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 57,
   "id": "42832286-a930-4f61-af54-85b676ea2a48",
   "metadata": {},
   "outputs": [],
   "source": [
    "class PrinterController:\n",
    "    def __init__(self, com_port, baud_rate=115200, timeout=2, debug=False):\n",
    "        \"\"\"\n",
    "        Инициализация соединения с принтером.\n",
    "        :param com_port: Номер COM-порта (например, 'COM3' или '/dev/ttyUSB0').\n",
    "        :param baud_rate: Скорость передачи данных (по умолчанию 115200).\n",
    "        :param timeout: Время ожидания ответа от принтера (в секундах).\n",
    "        \"\"\"\n",
    "        self.com_port = com_port\n",
    "        self.baud_rate = baud_rate\n",
    "        self.timeout = timeout\n",
    "        self.connection = None\n",
    "        self.debug_mode = debug\n",
    "        self.abs_mode = None\n",
    "\n",
    "    def connect(self):\n",
    "        \"\"\"        Подключение к принтеру.        \"\"\"\n",
    "        try:\n",
    "            self.connection = serial.Serial(self.com_port, self.baud_rate, timeout=self.timeout)\n",
    "            print(f\"Подключено к {self.com_port} со скоростью {self.baud_rate} бод\")\n",
    "        except Exception as e:\n",
    "            print(f\"Ошибка подключения: {e}\")\n",
    "\n",
    "    def disconnect(self):\n",
    "        \"\"\"        Отключение от принтера.        \"\"\"\n",
    "        if self.connection and self.connection.is_open:\n",
    "            self.connection.close()\n",
    "            print(\"Соединение закрыто\")\n",
    "\n",
    "    def send_command(self, command, read_response=True):\n",
    "        \"\"\"\n",
    "        Отправка команды на принтер.\n",
    "        :param command: Команда для отправки (строка G-кода).\n",
    "        :param read_response: Флаг, указывающий, нужно ли читать ответ принтера.\n",
    "        :return: Ответ принтера (если read_response=True).\n",
    "        \"\"\"\n",
    "        if not self.connection or not self.connection.is_open:\n",
    "            print(\"Ошибка: Соединение не установлено\")\n",
    "            return None\n",
    "\n",
    "        try:\n",
    "            # Отправка команды\n",
    "            self.connection.write((command + \"\\n\").encode('utf-8'))\n",
    "            if self.debug_mode:\n",
    "                print(f\"Отправлено: {command}\")\n",
    "\n",
    "            # Чтение ответа\n",
    "            if read_response:\n",
    "                response = \"\"\n",
    "                while True:\n",
    "                    line = self.connection.readline().decode('utf-8').strip()\n",
    "                    if not line:\n",
    "                        break\n",
    "                    response += line + \"\\n\"\n",
    "                return response.strip()\n",
    "        except Exception as e:\n",
    "            print(f\"Ошибка при отправке команды: {e}\")\n",
    "            return None\n",
    "\n",
    "    def home(self):\n",
    "        \"\"\"        Возврат всех осей в исходное положение (Home).        \"\"\"\n",
    "        self.send_command(\"G28\")\n",
    "\n",
    "    def set_temperature(self, tool_temp=None, bed_temp=None, wait=False):\n",
    "        \"\"\"\n",
    "        Установка температуры хотэнда и/или стола.\n",
    "        :param tool_temp: Температура хотэнда (в °C).\n",
    "        :param bed_temp: Температура стола (в °C).\n",
    "        :param wait: Ждать завершения нагрева.\n",
    "        \"\"\"\n",
    "        if tool_temp is not None:\n",
    "            command = f\"M109 S{tool_temp}\" if wait else f\"M104 S{tool_temp}\"\n",
    "            self.send_command(command)\n",
    "\n",
    "        if bed_temp is not None:\n",
    "            command = f\"M190 S{bed_temp}\" if wait else f\"M140 S{bed_temp}\"\n",
    "            self.send_command(command)\n",
    "\n",
    "    def move(self, x=None, y=None, z=None, e=None, speed=3000):\n",
    "        \"\"\"\n",
    "        Перемещение осей и экструдера.\n",
    "        :param x: Позиция по оси X (в мм).\n",
    "        :param y: Позиция по оси Y (в мм).\n",
    "        :param z: Позиция по оси Z (в мм).\n",
    "        :param e: Экструзия (в мм).\n",
    "        :param speed: Скорость перемещения (в мм/мин).\n",
    "        \"\"\"\n",
    "        if not self.abs_mode or self.abs_mode is None:\n",
    "            self._set_abs_cords()\n",
    "        \n",
    "        command = \"G1\"\n",
    "        if x is not None:\n",
    "            command += f\" X{x}\"\n",
    "        if y is not None:\n",
    "            command += f\" Y{y}\"\n",
    "        if z is not None:\n",
    "            command += f\" Z{z}\"\n",
    "        if e is not None:\n",
    "            command += f\" E{e}\"\n",
    "        command += f\" F{speed}\"\n",
    "\n",
    "        self.send_command(command)\n",
    "\n",
    "    def move_realtive(self, x=None, y=None, z=None, e=None, speed=3000):\n",
    "        \"\"\"\n",
    "        Перемещение осей и экструдера.\n",
    "        :param x: Позиция по оси X (в мм).\n",
    "        :param y: Позиция по оси Y (в мм).\n",
    "        :param z: Позиция по оси Z (в мм).\n",
    "        :param e: Экструзия (в мм).\n",
    "        :param speed: Скорость перемещения (в мм/мин).\n",
    "        \"\"\"\n",
    "        if self.abs_mode or self.abs_mode is None:\n",
    "            self._set_rel_cords()\n",
    "        \n",
    "        command = \"G1\"\n",
    "        if x is not None:\n",
    "            command += f\" X{x}\"\n",
    "        if y is not None:\n",
    "            command += f\" Y{y}\"\n",
    "        if z is not None:\n",
    "            command += f\" Z{z}\"\n",
    "        if e is not None:\n",
    "            command += f\" E{e}\"\n",
    "        command += f\" F{speed}\"\n",
    "\n",
    "        self.send_command(command)\n",
    "    \n",
    "    def _set_abs_cords(self):\n",
    "        \"\"\" Установка режима абсолютных координат \"\"\"\n",
    "        self.abs_mode = True\n",
    "        self.send_command(\"G90\")\n",
    "\n",
    "    def _set_rel_cords(self):\n",
    "        \"\"\" Установка режима относительных координат \"\"\"\n",
    "        self.abs_mode = False\n",
    "        self.send_command(\"G91\")\n",
    "    \n",
    "    def set_zero(self, x=0, y=0, z=0, e=0):\n",
    "        \"\"\"\n",
    "        Установка (начальных) координат.\n",
    "        :param x: Позиция по оси X (в мм).\n",
    "        :param y: Позиция по оси Y (в мм).\n",
    "        :param z: Позиция по оси Z (в мм).\n",
    "        :param e: Экструзия (в мм).\n",
    "        \"\"\"\n",
    "        command = \"G92\"\n",
    "        if x is not None:\n",
    "            command += f\" X{x}\"\n",
    "        if y is not None:\n",
    "            command += f\" Y{y}\"\n",
    "        if z is not None:\n",
    "            command += f\" Z{z}\"\n",
    "        if e is not None:\n",
    "            command += f\" E{e}\"\n",
    "        self.send_command(command)\n",
    "\n",
    "    def get_position(self, auto_print=False):\n",
    "        \"\"\"\n",
    "        Получение текущей позиции осей.\n",
    "        :return: Текущая позиция (строка).\n",
    "        \"\"\"\n",
    "        _message = self.send_command(\"M114\")\n",
    "        if auto_print:\n",
    "            print(_message)\n",
    "        return _message\n",
    "    "
   ]
  },
