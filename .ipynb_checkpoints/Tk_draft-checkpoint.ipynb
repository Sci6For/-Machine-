    "# ПУСКАТЕЛЬ\n",
    "try:\n",
    "    root = tk.Tk()\n",
    "    app = App(root, com_port='COM4', baud_rate=115200, timeout=2, debug=True, k_e=1/11)\n",
    "    root.mainloop()\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"Ошибка: {e}\")\n",
    "    root.destroy()\n",
    "\n",
    "finally:\n",
