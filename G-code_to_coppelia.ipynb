   "outputs": [],
   "source": [
    "try:\n",
    "    import sim\n",
    "except:\n",
    "    print('--------------------------------------------------------------')\n",
    "    print('\"sim.py\" could not be imported. This means very probably that')\n",
    "    print('either \"sim.py\" or the remoteApi library could not be found.')\n",
    "    print('Make sure both are in the same folder as this file,')\n",
    "    print('or appropriately adjust the file \"sim.py\"')\n",
    "    print('--------------------------------------------------------------')\n",
    "    print('')\n",
    "\n",
    "import time\n",
    "import numpy as np\n",
    "\n",
    "class Client_CoppeliaSim:\n",
    "    def __enter__(self):\n",
    "        # self.intSignalName = 'legacyRemoteApiStepCounter'\n",
    "        # self.stepCounter = 0\n",
    "        # self.maxForce = 100\n",
    "        sim.simxFinish(-1)  # just in case, close all opened connections\n",
    "        self.id = sim.simxStart('127.0.0.1', 19999, True, True, 5000, 5)  # Connect to CoppeliaSim\n",
    "        return self\n",
    "\n",
    "    def __exit__(self, *err):\n",
    "        # Для проверки, что все команды дошли засылаем ненужную команду возвращающую ответ\n",
    "        res, ping = sim.simxGetPingTime(self.id)\n",
    "        if res == 0:\n",
    "            print(\"ping time {0} ms\".format(ping))\n",
    "        else:\n",
    "            # https://www.coppeliarobotics.com/helpFiles/en/remoteApiConstants.htm#functionErrorCodes\n",
    "            print(\"ping error Code {0}\".format(res))\n",
    "        sim.simxFinish(-1)\n",
    "\n",
    "    def send_string(self, signal_name, signal):\n",
    "        sim.simxSetStringSignal(\n",
    "                clientID = self.id, \n",
    "                signalName = signal_name, \n",
    "                signalValue = signal, \n",
    "                operationMode = sim.simx_opmode_oneshot\n",
    "            )\n",
    "\n",
    "    def send_status_mesage(self, message):\n",
    "        sim.simxAddStatusbarMessage(self.id, message, sim.simx_opmode_oneshot)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "14f0abca-a368-4253-908a-cbb36383ba36",
   "metadata": {
    "scrolled": true
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Running\n",
      "Connected to remote API server\n",
      "ping time 78 ms\n",
      "Program ended\n"
     ]
    }
   ],
   "source": [
    "with Client_CoppeliaSim() as client:\n",
    "    print(\"Running\")\n",
    "\n",
    "    if client.id == -1:\n",
    "        print('Failed connecting to remote API server')\n",
    "    else:\n",
    "        print('Connected to remote API server')\n",
    "\n",
    "        # Now send some data to CoppeliaSim in a non-blocking fashion:\n",
    "        sim.simxAddStatusbarMessage(client.id, 'Python report!', sim.simx_opmode_oneshot)\n",
    "\n",
    "        # Засылание строки\n",
    "        sim.simxSetStringSignal(\n",
    "                clientID = client.id, \n",
    "                signalName = \"gcode_str\", \n",
    "                signalValue = 'G1 X0 Y0 Z10\\n G1 X10 Y50 Z100', \n",
    "                operationMode = sim.simx_opmode_oneshot\n",
    "            )\n",
    "\n",
    "print('Program ended')"
   ]
  },
