   "source": [
    "import pandas as pd\n",
    "from lumen import Dashboard\n",
    "\n",
    "# Создаем DataFrame с данными\n",
    "data = pd.DataFrame({\n",
    "    'year': [2000, 2001, 2002, 2003, 2004, 2005],\n",
    "    'category': ['A', 'B', 'A', 'C', 'B', 'D'],\n",
    "    'value': [100, 150, 200, 300, 400, 500]\n",
    "})\n",
    "\n",
    "# Определяем конфигурацию дашборда в формате YAML (как строка)\n",
    "yaml_config = \"\"\"\n",
    "title: \"Пример дашборда Lumen\"\n",
    "\n",
    "sources:\n",
    "  dataframe:  # Источник данных — DataFrame\n",
    "    type: dataframe\n",
    "    data:\n",
    "      value: !expr data  # Ссылка на наш DataFrame\n",
    "\n",
    "widgets:\n",
    "  - name: year_slider\n",
    "    type: range_slider\n",
    "    field: year\n",
    "    label: \"Выберите диапазон лет\"\n",
    "    start: 2000\n",
    "    end: 2005\n",
    "\n",
    "  - name: category_filter\n",
    "    type: multi_select\n",
    "    field: category\n",
    "    label: \"Выберите категории\"\n",
    "    options: [\"A\", \"B\", \"C\", \"D\"]\n",
    "\n",
    "plots:\n",
    "  - type: bar\n",
    "    x: category\n",
    "    y: value\n",
    "    title: \"Суммарное значение по категориям\"\n",
    "    filters: [year_slider, category_filter]\n",
    "\n",
    "  - type: line\n",
    "    x: year\n",
    "    y: value\n",
    "    title: \"Динамика значений по годам\"\n",
    "    filters: [category_filter]\n",
    "\"\"\"\n",
    "\n",
    "# Создаем дашборд из YAML-конфигурации\n",
    "dashboard = Dashboard.from_spec(yaml_config)\n",
    "\n",
    "# Отображаем дашборд\n",
    "dashboard.show()"
   ]
  },
