   "source": [
    "\n",
    "from modules.PrinterController_01 import PrinterController\n",
    "\n",
    "printer = PrinterController(port=\"COM3\", baudrate=115200)\n",
    "printer.connect()\n",
    "\n",
    "gcode_file = \"example.gcode\"\n",
    "with open(gcode_file, \"r\") as f:\n",
    "    gcode_lines = f.readlines()\n",
    "\n",
    "printer.run_gcode(gcode_lines)\n",
    "printer.disconnect()\n"
   ]
  }
